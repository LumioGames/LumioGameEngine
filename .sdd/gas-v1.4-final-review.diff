+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://lumio.games/schema/gas-effect-events.schema.json",
+  "title": "GAS Effect same-tick event contract",
+  "description": "Effect events are ordered on the simulation Tick. Suppression is Active-internal and application plus removal in one Tick cancels.",
+  "type": "object",
+  "required": ["kind", "effectId", "tickId", "initialState", "events", "finalState"],
+  "properties": {
+    "kind": { "type": "string", "const": "EffectTick" },
+    "effectId": { "$ref": "common.schema.json#/$defs/id" },
+    "tickId": { "$ref": "common.schema.json#/$defs/tickId" },
+    "initialState": { "$ref": "#/$defs/effectState" },
+    "events": {
+      "type": "array",
+      "minItems": 1,
+      "items": { "$ref": "#/$defs/event" }
+    },
+    "eventOrder": {
+      "type": "array",
+      "items": { "$ref": "#/$defs/eventName" }
+    },
+    "finalState": { "$ref": "#/$defs/effectState" },
+    "handleValid": { "type": "boolean" },
+    "sameTickOutcome": { "type": "string", "enum": ["Applied", "Cancelled", "Expired", "Removed", "Noop"] },
+    "durationTicks": { "type": "integer", "minimum": 1 },
+    "periodTicks": { "type": "integer", "minimum": 1 },
+    "expiresAtTick": { "$ref": "common.schema.json#/$defs/tickId" },
+    "nextPeriodTick": { "$ref": "common.schema.json#/$defs/tickId" },
+    "suppressed": { "type": "boolean" }
+  },
+  "additionalProperties": false,
+  "$defs": {
+    "effectState": {
+      "type": "string",
+      "enum": ["Pending", "Active", "Expired", "Removed", "Rejected", "RolledBack"]
+    },
+    "eventName": {
+      "type": "string",
+      "enum": ["Apply", "Hit", "Overflow", "SnapshotReplacement", "Stack", "Refresh", "Suppress", "Duration", "Period", "Removal", "Expire"]
+    },
+    "event": {
+      "type": "object",
+      "required": ["order", "event", "tickId"],
+      "properties": {
+        "order": { "type": "integer", "minimum": 1 },
+        "event": { "$ref": "#/$defs/eventName" },
+        "tickId": { "$ref": "common.schema.json#/$defs/tickId" },
+        "fromState": { "$ref": "#/$defs/effectState" },
+        "toState": { "$ref": "#/$defs/effectState" },
+        "stackCount": { "type": "integer", "minimum": 0 },
+        "overflowCount": { "type": "integer", "minimum": 0 },
+        "snapshotId": { "$ref": "common.schema.json#/$defs/id" },
+        "durationTicks": { "type": "integer", "minimum": 1 },
+        "periodTicks": { "type": "integer", "minimum": 1 },
+        "suppressed": { "type": "boolean" }
+      },
+      "additionalProperties": false
+    }
+  }
+}
