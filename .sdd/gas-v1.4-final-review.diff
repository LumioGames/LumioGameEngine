+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://lumio.games/schema/gas-components.schema.json",
+  "title": "GAS ECS component containers and world-bound handles",
+  "description": "The GAS projection has exactly four ECS containers. Each row resolves TypeId to an ECS row and a world-bound index plus generation handle.",
+  "type": "object",
+  "required": ["kind", "schemaVersion", "worldId", "entityId", "components", "handleProbes"],
+  "properties": {
+    "kind": { "type": "string", "const": "Components" },
+    "schemaVersion": { "type": "integer", "const": 1 },
+    "worldId": { "$ref": "common.schema.json#/$defs/id" },
+    "entityId": { "$ref": "common.schema.json#/$defs/id" },
+    "components": {
+      "type": "array",
+      "minItems": 4,
+      "maxItems": 4,
+      "items": {
+        "oneOf": [
+          { "$ref": "#/$defs/abilityContainer" },
+          { "$ref": "#/$defs/effectContainer" },
+          { "$ref": "#/$defs/attributeContainer" },
+          { "$ref": "#/$defs/tagContainer" }
+        ]
+      }
+    },
+    "handleProbes": {
+      "type": "array",
+      "minItems": 3,
+      "items": { "$ref": "#/$defs/handleProbe" }
+    }
+  },
+  "additionalProperties": false,
+  "$defs": {
+    "row": {
+      "type": "object",
+      "required": ["index"],
+      "properties": {
+        "index": { "type": "integer", "minimum": 0 }
+      },
+      "additionalProperties": false
+    },
+    "handle": {
+      "type": "object",
+      "required": ["worldId", "index", "generation", "valid"],
+      "properties": {
+        "worldId": { "$ref": "common.schema.json#/$defs/id" },
+        "index": { "type": "integer", "minimum": 0 },
+        "generation": { "type": "integer", "minimum": 1 },
+        "valid": { "type": "boolean" }
+      },
+      "additionalProperties": false
+    },
+    "abilityEntry": {
+      "type": "object",
+      "required": ["typeId", "instanceId", "row", "handle", "state"],
+      "properties": {
+        "typeId": { "$ref": "common.schema.json#/$defs/id" },
+        "instanceId": { "$ref": "common.schema.json#/$defs/id" },
+        "row": { "$ref": "#/$defs/row" },
+        "handle": { "$ref": "#/$defs/handle" },
+        "handleValid": { "type": "boolean" },
+        "state": { "$ref": "gas-lifecycle.schema.json#/$defs/abilityState" },
+        "suspended": { "type": "boolean" },
+        "resumeCondition": {
+          "type": "string",
+          "enum": ["Frame", "InputEvent", "TagAttributeEffectChange", "PresentationComplete"]
+        },
+        "resumeParameter": { "$ref": "common.schema.json#/$defs/id" }
+      },
+      "additionalProperties": false
+    },
+    "effectEntry": {
+      "type": "object",
+      "required": ["typeId", "instanceId", "row", "handle", "state"],
+      "properties": {
+        "typeId": { "$ref": "common.schema.json#/$defs/id" },
+        "instanceId": { "$ref": "common.schema.json#/$defs/id" },
+        "row": { "$ref": "#/$defs/row" },
+        "handle": { "$ref": "#/$defs/handle" },
+        "handleValid": { "type": "boolean" },
+        "state": { "$ref": "gas-lifecycle.schema.json#/$defs/effectState" },
+        "fx_key": { "$ref": "common.schema.json#/$defs/id" },
+        "suppressed": { "type": "boolean" },
+        "stackCount": { "type": "integer", "minimum": 1 },
+        "durationTicks": { "type": "integer", "minimum": 1 },
+        "periodTicks": { "type": "integer", "minimum": 1 },
+        "expiresAtTick": { "$ref": "common.schema.json#/$defs/tickId" },
+        "nextPeriodTick": { "$ref": "common.schema.json#/$defs/tickId" }
+      },
+      "additionalProperties": false
+    },
+    "attributeEntry": {
+      "type": "object",
+      "required": ["typeId", "instanceId", "row", "handle", "attributeId", "base", "current", "revision"],
+      "properties": {
+        "typeId": { "$ref": "common.schema.json#/$defs/id" },
+        "instanceId": { "$ref": "common.schema.json#/$defs/id" },
+        "row": { "$ref": "#/$defs/row" },
+        "handle": { "$ref": "#/$defs/handle" },
+        "handleValid": { "type": "boolean" },
+        "attributeId": { "$ref": "common.schema.json#/$defs/id" },
+        "base": { "type": "number" },
+        "current": { "type": "number" },
+        "revision": { "$ref": "common.schema.json#/$defs/revision" }
+      },
+      "additionalProperties": false
+    },
+    "tagEntry": {
+      "type": "object",
+      "required": ["typeId", "instanceId", "row", "handle", "tagId", "count"],
+      "properties": {
+        "typeId": { "$ref": "common.schema.json#/$defs/id" },
+        "instanceId": { "$ref": "common.schema.json#/$defs/id" },
+        "row": { "$ref": "#/$defs/row" },
+        "handle": { "$ref": "#/$defs/handle" },
+        "handleValid": { "type": "boolean" },
+        "tagId": { "$ref": "common.schema.json#/$defs/id" },
+        "count": { "type": "integer", "minimum": 1 }
+      },
+      "additionalProperties": false
+    },
+    "abilityContainer": {
+      "type": "object",
+      "required": ["component", "entries"],
+      "properties": {
+        "component": { "type": "string", "const": "AbilityComponent" },
+        "entries": { "type": "array", "items": { "$ref": "#/$defs/abilityEntry" } }
+      },
+      "additionalProperties": false
+    },
+    "effectContainer": {
+      "type": "object",
+      "required": ["component", "entries"],
+      "properties": {
+        "component": { "type": "string", "const": "EffectComponent" },
+        "entries": { "type": "array", "items": { "$ref": "#/$defs/effectEntry" } }
+      },
+      "additionalProperties": false
+    },
+    "attributeContainer": {
+      "type": "object",
+      "required": ["component", "entries"],
+      "properties": {
+        "component": { "type": "string", "const": "AttributeComponent" },
+        "entries": { "type": "array", "items": { "$ref": "#/$defs/attributeEntry" } }
+      },
+      "additionalProperties": false
+    },
+    "tagContainer": {
+      "type": "object",
+      "required": ["component", "entries"],
+      "properties": {
+        "component": { "type": "string", "const": "TagComponent" },
+        "entries": { "type": "array", "items": { "$ref": "#/$defs/tagEntry" } }
+      },
+      "additionalProperties": false
+    },
+    "handleProbe": {
+      "type": "object",
+      "required": ["handle", "expected"],
+      "properties": {
+        "handle": { "$ref": "#/$defs/handle" },
+        "expected": { "type": "string", "enum": ["Accepted", "Rejected"] },
+        "reason": {
+          "type": "string",
+          "enum": ["StaleGeneration", "CrossWorld", "Terminal", "MissingRow"]
+        }
+      },
+      "allOf": [
+        {
+          "if": { "properties": { "expected": { "const": "Accepted" } }, "required": ["expected"] },
+          "then": { "not": { "required": ["reason"] } }
+        },
+        {
+          "if": { "properties": { "expected": { "const": "Rejected" } }, "required": ["expected"] },
+          "then": { "required": ["reason"] }
+        }
+      ],
+      "additionalProperties": false
+    }
+  }
+}
