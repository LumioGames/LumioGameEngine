@@ -0,0 +1,66 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "https://lumio.games/schema/gas-prediction.schema.json",
+  "title": "GAS frame-keyed prediction rejection and replay",
+  "description": "The input frame is the prediction key. Rejection restores one ECS/GAS/Voxel client frame and deterministically replays unconfirmed inputs; the server never rolls back.",
+  "type": "object",
+  "required": ["kind", "schemaVersion", "worldId", "inputFrame", "predictionKey", "windowBoundary", "authorityDecision", "nonPredictableActions", "rollback"],
+  "properties": {
+    "kind": { "type": "string", "const": "PredictionRollback" },
