{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.games/schema/replication-envelope.schema.json",
  "type": "object",
  "required": [
    "protocolVersion",
    "length",
    "sequence",
    "sessionId",
    "productId",
    "gameReleaseId",
    "messageType",
    "reliability",
    "integrity",
    "traceId",
    "payload"
  ],
  "properties": {
    "protocolVersion": { "type": "integer", "minimum": 1 },
    "length": { "type": "integer", "minimum": 0 },
    "sequence": { "$ref": "common.schema.json#/$defs/revision" },
    "sessionId": { "$ref": "common.schema.json#/$defs/id" },
    "productId": { "$ref": "common.schema.json#/$defs/productId" },
    "gameReleaseId": { "$ref": "common.schema.json#/$defs/releaseId" },
    "messageType": {
      "type": "string",
      "enum": ["Handshake", "FullSnapshot", "BaselineAck", "Delta", "DeltaAck", "ResyncRequest", "MaintenanceKick", "Error"]
    },
    "reliability": { "type": "string", "enum": ["Reliable", "Unreliable"] },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["None", "CRC32C", "SHA256", "AEAD"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "traceId": { "$ref": "common.schema.json#/$defs/id" },
    "snapshotId": { "$ref": "common.schema.json#/$defs/id" },
    "baseSnapshotId": { "$ref": "common.schema.json#/$defs/id" },
    "fromRevision": { "$ref": "common.schema.json#/$defs/revision" },
    "toRevision": { "$ref": "common.schema.json#/$defs/revision" },
    "baselineAck": { "type": "boolean" },
    "gapDetected": { "type": "boolean" },
    "resyncReason": { "type": "string", "enum": ["Gap", "UnknownBaseline", "RevisionTooOld", "SchemaMismatch", "TombstoneConflict", "HistoryUnavailable"] },
    "payload": { "type": ["object", "array", "string", "number", "boolean", "null"] }
  },
  "additionalProperties": false
}
