{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.games/schema/verified-package-descriptor.schema.json",
  "type": "object",
  "required": ["descriptorVersion", "packageIdentity", "trustDecision", "trustDomain", "verifierVersion", "verifiedAt", "checks"],
  "properties": {
    "descriptorVersion": { "type": "integer", "minimum": 1 },
    "packageIdentity": {
      "type": "object",
      "required": ["manifestDigest", "artifactSetDigest", "abiIdentity", "targetProfileDigest", "capabilitySetDigest"],
      "properties": {
        "manifestDigest": { "$ref": "common.schema.json#/$defs/hash256" },
        "artifactSetDigest": { "$ref": "common.schema.json#/$defs/hash256" },
        "abiIdentity": { "type": "string", "pattern": "^NativeManagedAbiV[0-9]+$" },
        "targetProfileDigest": { "$ref": "common.schema.json#/$defs/hash256" },
        "capabilitySetDigest": { "$ref": "common.schema.json#/$defs/hash256" }
      },
      "additionalProperties": false
    },
    "trustDecision": { "type": "string", "enum": ["Trusted", "Rejected"] },
    "rejectReason": { "$ref": "common.schema.json#/$defs/id" },
    "trustDomain": { "type": "string", "enum": ["Production", "Staging", "Test"] },
    "verifierVersion": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "verifiedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "checks": {
      "type": "object",
      "required": ["manifestDigestVerified", "artifactDigestsVerified", "signatureVerified", "trustPolicyVerified"],
      "properties": {
        "manifestDigestVerified": { "type": "boolean" },
        "artifactDigestsVerified": { "type": "boolean" },
        "signatureVerified": { "type": "boolean" },
        "trustPolicyVerified": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
