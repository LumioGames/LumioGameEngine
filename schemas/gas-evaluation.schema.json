{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.games/schema/gas-evaluation.schema.json",
  "title": "GAS deterministic evaluation contract",
  "description": "V1 evaluates one channel as (Base + SigmaAdd) * (1 + SigmaPercent), then applies an explicit-priority override. Add and Percent terms are reduced by ascending sequence and a code-point ascending modifier id tie-breaker in a 34-digit decimal context with ROUND_HALF_EVEN rounding; JSON array order is never semantic. Numeric members are parsed as exact JSON decimal values, rounded under Decimal34, bounded by adjusted exponent -6176..6144 (normal Emin -6143, subnormal floor -6176) and at most 1024 coefficient digits.",
  "type": "object",
  "required": ["kind", "attributeId", "base", "modifiers", "formula", "operators", "percentageAggregation", "overrideTieBreak", "accumulationOrder", "numericPolicy", "result"],
  "properties": {
    "kind": { "type": "string", "const": "Evaluation" },
    "attributeId": { "$ref": "common.schema.json#/$defs/id" },
    "base": { "$ref": "#/$defs/gasNumber" },
    "modifiers": {
      "type": "array",
      "items": { "$ref": "#/$defs/modifier" }
    },
    "overrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/override" }
    },
    "formula": { "type": "string", "const": "(Base + SigmaAdd) * (1 + SigmaPercent)" },
    "operators": {
      "type": "array",
      "const": ["Add", "Percent", "Override"],
      "items": { "type": "string", "enum": ["Add", "Percent", "Override"] }
    },
    "percentageAggregation": { "type": "string", "const": "Additive" },
    "overrideTieBreak": { "type": "string", "const": "PriorityDescendingThenSequenceDescending" },
    "accumulationOrder": { "type": "string", "const": "SequenceAscendingThenIdCodePointAscending" },
    "numericPolicy": { "type": "string", "const": "Decimal34RoundHalfEven" },
    "channel": { "type": "string", "const": "Default" },
    "result": { "$ref": "#/$defs/gasNumber" }
  },
  "additionalProperties": false,
  "$defs": {
    "gasNumber": {
      "type": "number",
      "description": "Exact JSON numeric member; semantic validation applies Decimal34 ROUND_HALF_EVEN with adjusted exponent -6176..6144 (normal Emin -6143, subnormal floor -6176) and at most 1024 coefficient digits."
    },
    "modifier": {
      "type": "object",
      "required": ["id", "operator", "value", "priority", "sequence"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "operator": { "type": "string", "enum": ["Add", "Percent", "Override"] },
        "value": { "$ref": "#/$defs/gasNumber" },
        "priority": { "type": "integer", "minimum": 0 },
        "sequence": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "override": {
      "type": "object",
      "required": ["id", "value", "priority", "sequence"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/id" },
        "value": { "$ref": "#/$defs/gasNumber" },
        "priority": { "type": "integer", "minimum": 0 },
        "sequence": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  }
}
