{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.games/schema/gas-lifecycle.schema.json",
  "type": "object",
  "required": ["machine", "instanceId", "fromState", "toState", "event"],
  "properties": {
    "machine": { "type": "string", "enum": ["Ability", "Effect"] },
    "instanceId": { "$ref": "common.schema.json#/$defs/id" },
    "fromState": { "type": "string" },
    "toState": { "type": "string" },
    "event": { "$ref": "common.schema.json#/$defs/id" },
    "handleValid": { "type": "boolean" },
    "predicted": { "type": "boolean" }
  },
  "additionalProperties": false
}
