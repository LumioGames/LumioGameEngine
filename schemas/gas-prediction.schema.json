{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.games/schema/gas-prediction.schema.json",
  "title": "GAS frame-keyed prediction rejection and replay",
  "description": "The input frame is the prediction key. Rejection restores one ECS/GAS/Voxel client frame and deterministically replays unconfirmed inputs; the server never rolls back.",
  "type": "object",
  "required": ["kind", "schemaVersion", "worldId", "inputFrame", "predictionKey", "windowBoundary", "authorityDecision", "nonPredictableActions", "rollback"],
  "properties": {
    "kind": { "type": "string", "const": "PredictionRollback" },
    "schemaVersion": { "type": "integer", "const": 1 },
    "worldId": { "$ref": "common.schema.json#/$defs/id" },
    "inputFrame": { "$ref": "common.schema.json#/$defs/tickId" },
    "predictionKey": { "$ref": "common.schema.json#/$defs/tickId" },
    "windowBoundary": { "type": "string", "const": "GasAndEventFinalize" },
    "authorityDecision": { "type": "string", "const": "Rejected" },
    "nonPredictableActions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/nonPredictableAction" }
    },
    "rollback": { "$ref": "#/$defs/rollback" }
  },
  "additionalProperties": false,
  "$defs": {
    "nonPredictableAction": {
      "type": "object",
      "required": ["action", "predicted"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["EffectRemoval", "EffectPeriod", "OutOfSimulation"]
        },
        "predicted": { "type": "boolean", "const": false }
      },
      "additionalProperties": false
    },
    "rollback": {
      "type": "object",
      "required": ["unit", "frameCount", "confirmedFrame", "clientRolledBack", "serverRolledBack", "steps", "replayInputFrames", "deterministicReplay"],
      "properties": {
        "unit": { "type": "string", "const": "EcsGasVoxelFrame" },
        "frameCount": { "type": "integer", "const": 1 },
        "confirmedFrame": { "$ref": "common.schema.json#/$defs/tickId" },
        "clientRolledBack": { "type": "boolean", "const": true },
        "serverRolledBack": { "type": "boolean", "const": false },
        "steps": {
          "type": "array",
          "const": ["RestoreConfirmedFrame", "ApplyAuthoritativeEcsGasVoxel", "ReplayUnconfirmedInputs"],
          "items": {
            "type": "string",
            "enum": ["RestoreConfirmedFrame", "ApplyAuthoritativeEcsGasVoxel", "ReplayUnconfirmedInputs"]
          }
        },
        "replayInputFrames": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "common.schema.json#/$defs/tickId" }
        },
        "deterministicReplay": { "type": "boolean", "const": true }
      },
      "additionalProperties": false
    }
  }
}
