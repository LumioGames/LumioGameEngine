{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lumio.games/schema/replication-envelope.schema.json",
  "type": "object",
  "required": [
    "protocolVersion",
    "length",
    "sequence",
    "sessionId",
    "productId",
    "gameReleaseId",
    "messageType",
    "reliability",
    "integrity",
    "traceId",
    "transportPolicy",
    "body"
  ],
  "properties": {
    "protocolVersion": { "type": "integer", "minimum": 1 },
    "length": { "type": "integer", "minimum": 0 },
    "sequence": { "$ref": "common.schema.json#/$defs/revision" },
    "sessionId": { "$ref": "common.schema.json#/$defs/id" },
    "productId": { "$ref": "common.schema.json#/$defs/productId" },
    "gameReleaseId": { "$ref": "common.schema.json#/$defs/releaseId" },
    "messageType": {
      "type": "string",
      "enum": [
        "Handshake",
        "FullSnapshot",
        "BaselineAck",
        "Delta",
        "DeltaAck",
        "ResyncRequest",
        "MaintenanceKick",
        "Error"
      ]
    },
    "reliability": { "type": "string", "enum": ["Reliable", "Unreliable"] },
    "integrity": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["None", "CRC32C", "SHA256", "AEAD"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "additionalProperties": false
    },
    "traceId": { "$ref": "common.schema.json#/$defs/id" },
    "transportPolicy": {
      "type": "object",
      "required": ["maxMessageBytes", "maxFragmentBytes", "antiReplayWindow", "authBinding", "errorClass"],
      "properties": {
        "maxMessageBytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "maxFragmentBytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
        "antiReplayWindow": { "type": "integer", "minimum": 1 },
        "authBinding": { "type": "string", "enum": ["SessionAdmission", "ConnectionGeneration"] },
        "errorClass": { "type": "string", "enum": ["Retryable", "Rejectable", "Fatal"] }
      },
      "additionalProperties": false
    },
    "body": { "type": "object" }
  },
  "additionalProperties": false
}
